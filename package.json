{
  "name": "servercommander-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.22",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun dist/src/index.js",
    "db:migrate": "bun src/db/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "discord.js": "^14.20.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.1",
    "pg": "^8.20.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
