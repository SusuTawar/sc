# Timezone
TZ=Asia/Jakarta

# Caddy (optional; use in Caddyfile global options if needed)
CADDY_EMAIL=admin@example.com

# ServerCommander (TypeScript app)
SC_HTTP_PORT=8080
SC_DB_DSN=postgres://postgres:change_me_postgres_root@postgres:5432/servercommander
SC_WEBHOOK_SECRET=change_me_webhook_secret
SC_API_TOKEN=change_me_api_token
SC_WEBHOOK_MAX_BYTES=2147483648
SC_WEBHOOK_SKEW_SEC=300
SC_UPLOAD_TMP_DIR=/tmp/servercommander
SC_DISCORD_ENABLED=true
SC_DISCORD_BOT_TOKEN=change_me
SC_DISCORD_GUILD_ID=change_me
SC_DISCORD_OPERATOR_IDS=1234567890,9988776655
SC_DOCKER_EDGE_NETWORK=edge
SC_CADDY_MODE=docker-proxy
SC_LOG_LEVEL=info
SC_AUTO_CREATE_APP=true
SC_REPLAY_TTL_SEC=600
SC_RUN_MIGRATIONS_ON_BOOT=true

# MySQL
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=change_me_mysql_user

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=servercommander
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_root
